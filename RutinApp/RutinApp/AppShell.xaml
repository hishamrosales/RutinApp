<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RutinApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RutinApp"
    xmlns:views="clr-namespace:RutinApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="RutinApp">

    <TabBar>
        <Tab Title="Mis Rutinas">
            <ShellContent x:Name="MisRutinasPage"
                      Route="MisRutinasPage"
                      ContentTemplate="{DataTemplate views:MisRutinasPage}"/>
        </Tab>
        <Tab Title="Ejercicios">
            <ShellContent Route="EjerciciosPage"
                      ContentTemplate="{DataTemplate views:EjerciciosPage}"/>
        </Tab>
    </TabBar>

</Shell>
