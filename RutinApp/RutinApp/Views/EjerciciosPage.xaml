<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RutinApp.ViewModels"
             x:Class="RutinApp.Views.EjerciciosPage"
             Title="Ejercicios">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *">

            <Button Grid.Row="0"
                    Text="+ Agregar Ejercicio"
                    Command="{Binding GoToAddPageCommand}"
                    Margin="16"
                    HorizontalOptions="End"/>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Ejercicios}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar"
                                               BackgroundColor="Orange"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EjercicioViewModel}}, Path=GoToEditPageCommand}"
                                               CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Eliminar"
                                               BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EjercicioViewModel}}, Path=DeleteEjercicioCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="16, 8" ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Nombre}"
                                           FontSize="16"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding GrupoMuscular}"
                                           FontSize="13"
                                           TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </ContentPage.Content>
</ContentPage>