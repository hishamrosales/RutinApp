<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RutinApp.ViewModels"
             x:Class="RutinApp.Views.SesionPage"
             Title=""
             BackgroundColor="{StaticResource AppBackground}">
    
    <Grid RowDefinitions="Auto, Auto, *,  Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="24,52,24,16" Spacing="4">
            <Label Text="{Binding NombreRutina}"
                   FontSize="14"
                   TextColor="{StaticResource TextSecondary}"/>
            <Label Text="{Binding NombreEjercicioActual}"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"/>
            <Label Text="{Binding GrupoMuscularActual}"
                   FontSize="13"
                   TextColor="{StaticResource AccentOrange}"/>
        </VerticalStackLayout>

        <!-- Barra de progreso -->
        <VerticalStackLayout Grid.Row="1" Padding="24,0,24,16" Spacing="6">
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="Progreso total"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"/>
                <Label Grid.Column="1"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0}/{1} ejercicios">
                            <Binding Path="EjercicioActualNumero"/>
                            <Binding Path="TotalEjercicios"/>
                        </MultiBinding>
                    </Label.Text>
                </Label>
            </Grid>
            <ProgressBar Progress="{Binding Progreso}"
                         ProgressColor="{StaticResource AccentOrange}"
                         BackgroundColor="{StaticResource CardBackground}"/>
        </VerticalStackLayout>

        <!-- Lista de series -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Series}"
                        Margin="24,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12"
                            Padding="16"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.BackgroundColor>
                            <Binding Path="Completada">
                                <Binding.Converter>
                                    <x:StaticResource Key="BoolToColorConverter"/>
                                </Binding.Converter>
                            </Binding>
                        </Border.BackgroundColor>

                        <Grid ColumnDefinitions="Auto, *, *, Auto" ColumnSpacing="12">

                            <!-- Número de serie -->
                            <Label Grid.Column="0"
                                   Text="{Binding NumeroSerie, StringFormat='Serie {0}'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>

                            <!-- Peso -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Peso (kg)"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Border BackgroundColor="#1C1C2E" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding PesoUtilizado}"
                                           Keyboard="Numeric"
                                           TextColor="{StaticResource TextPrimary}"
                                           BackgroundColor="Transparent"
                                           HorizontalTextAlignment="Center"
                                           IsEnabled="{Binding Completada, Converter={StaticResource InvertedBoolConverter}}"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Reps -->
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Reps"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Border BackgroundColor="#1C1C2E" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding RepsLogradas}"
                                           Keyboard="Numeric"
                                           TextColor="{StaticResource TextPrimary}"
                                           BackgroundColor="Transparent"
                                           HorizontalTextAlignment="Center"
                                           IsEnabled="{Binding Completada, Converter={StaticResource InvertedBoolConverter}}"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Botón Done -->
                            <Border Grid.Column="3"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Border.BackgroundColor>
                                    <StaticResource Key="AccentOrange"/>
                                </Border.BackgroundColor>
                                <Button Text="Done"
                                        BackgroundColor="Transparent"
                                        TextColor="White"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SesionViewModel}}, Path=MarcarSerieCompletadaCommand}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding Completada, Converter={StaticResource InvertedBoolConverter}}"/>
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botón siguiente / finalizar -->
        <Grid Grid.Row="3" Margin="24,12,24,32">
            <Border StrokeThickness="0"
            IsVisible="{Binding EsUltimoEjercicio, Converter={StaticResource InvertedBoolConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF6B2B" Offset="0"/>
                        <GradientStop Color="#C0392B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Button Text="Siguiente ejercicio →"
                Command="{Binding SiguienteEjercicioCommand}"
                BackgroundColor="Transparent"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"/>
            </Border>

            <Border StrokeThickness="0"
            IsVisible="{Binding EsUltimoEjercicio}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2ECC71" Offset="0"/>
                        <GradientStop Color="#27AE60" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Button Text="¡Finalizar sesión! 🎉"
                Command="{Binding SiguienteEjercicioCommand}"
                BackgroundColor="Transparent"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"/>
            </Border>
        </Grid>

    </Grid>
</ContentPage>