<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RutinApp.ViewModels"
             x:Class="RutinApp.Views.MisRutinasPage"
             Title="Mis Rutinas"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" Padding="24,52,24,8" ColumnDefinitions="*, Auto">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Mis Rutinas"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="+"
                    FontSize="24"
                    TextColor="{StaticResource AccentOrange}"
                    BackgroundColor="Transparent"
                    Command="{Binding GoToAddPageCommand}"
                    VerticalOptions="Center"/>
        </Grid>

        <Border Grid.Row="1"
                Margin="24,0,24,16"
                BackgroundColor="{StaticResource CardBackground}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <SearchBar Placeholder="Buscar"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent"/>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Rutinas}"
                        Margin="24,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutinaViewModel}}, Path=GoToEditPageCommand}"
                                CommandParameter="{Binding .}"/>
                            <TapGestureRecognizer
                                Buttons="Secondary"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutinaViewModel}}, Path=ShowOptionsCommand}"
                                CommandParameter="{Binding .}"/>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutinaViewModel}}, Path=IniciarSesionCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding NombreRutina}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="TailTruncation"/>

                            <Grid HorizontalOptions="Center"
                                  WidthRequest="70"
                                  HeightRequest="70">
                                <Ellipse WidthRequest="70"
                                         HeightRequest="70"
                                         Stroke="{StaticResource CardBackground}"
                                         StrokeThickness="6"
                                         Fill="Transparent"/>
                                <Ellipse WidthRequest="70"
                                         HeightRequest="70"
                                         Stroke="{StaticResource AccentOrange}"
                                         StrokeThickness="6"
                                         Fill="Transparent"/>
                                <Label Text="0%"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <Label Text="{Binding RutinaEjercicios.Count, StringFormat='{0} ejercicios'}"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,12,0,24">
                    <Border Grid.Column="0"
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource CardBackground}"
                            StrokeThickness="2"
                            Padding="16"
                            HeightRequest="120">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAddPageCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="8">
                            <Label Text="+"
                                   FontSize="28"
                                   TextColor="{StaticResource AccentOrange}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Crear Nueva Rutina"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>