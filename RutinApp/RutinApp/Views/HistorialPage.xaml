<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RutinApp.Views.HistorialPage"
             Title="Historial"
             BackgroundColor="{StaticResource AppBackground}">

    <CollectionView ItemsSource="{Binding Historial}" Margin="20">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame CornerRadius="12"
                       Padding="12"
                       Margin="0,0,0,10"
                       BackgroundColor="{StaticResource CardBackground}">

                    <VerticalStackLayout>
                        <Label Text="{Binding NombreRutina}"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label Text="{Binding Fecha, StringFormat='{}{0:dd MMM yyyy - HH:mm}'}"
                               FontSize="12"
                               TextColor="Gray"/>

                        <Label Text="{Binding Resumen}"
                               FontSize="12"
                               TextColor="Orange"/>
                    </VerticalStackLayout>

                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>