<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RutinApp.Views.AddEjercicioPage"
             Title="Agregar Ejercicio">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <Label Text="Nombre del ejercicio" FontAttributes="Bold"/>
            <Entry Text="{Binding Nombre}"
                   Placeholder="Ej. Press de Banca"/>
            <Label Text="El nombre es requerido"
                   TextColor="Red"
                   IsVisible="{Binding IsNombreValid, Converter={StaticResource InvertedBoolConverter}}"/>

            <Label Text="Grupo muscular" FontAttributes="Bold"/>
            <Entry Text="{Binding GrupoMuscular}"
                   Placeholder="Ej. Pecho"/>

            <Label Text="Descripción" FontAttributes="Bold"/>
            <Editor Text="{Binding Descripcion}"
                    Placeholder="Descripción del ejercicio..."
                    HeightRequest="100"/>

            <Button Text="Guardar"
                    Command="{Binding SaveEjercicioCommand}"
                    IsEnabled="{Binding IsFormValid}"
                    Margin="0,12,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>